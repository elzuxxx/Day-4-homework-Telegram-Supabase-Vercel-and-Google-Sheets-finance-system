# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service role (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Server-to-server shared secrets
APP_INTERNAL_TOKEN=change-me-to-a-long-random-secret
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-secret
TELEGRAM_BOT_TOKEN=
# Google service account; put the whole JSON key on one line, escaped as JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
GOOGLE_SHEETS_ID=
# Public links displayed in the app
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-user/your-repo
NEXT_PUBLIC_STUDENT_NAME=Your Name
